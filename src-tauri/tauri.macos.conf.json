{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biolaris Media",
  "identifier": "io.github.bspitalieri.biolaris-media",
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "packages/macos/entitlements.plist",
      "dmg": {
        "background": "icons/dmgcanvas_bg.png",
