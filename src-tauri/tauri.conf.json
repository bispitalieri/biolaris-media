{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biolaris Media",
  "version": "0.1.7",
  "identifier": "io.github.bspitalieri.biolaris-media",
  "bundle": {
    "active": true,
    "longDescription": "Biolaris Media",
    "shortDescription": "Biolaris Media",
    "publisher": "Biolaris Media",
    "copyright": "AGPL-3.0-only",
    "category": "DeveloperTool",
    "resources": {
      "binaries/runtime-current/": "runtime/",
      "../.github/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "title": "Biolaris Media",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$DOWNLOAD/**", "$DESKTOP/**", "$DOCUMENTS/**", "$VIDEO/**", "$AUDIO/**", "$PICTURE/**"],
          "requireLiteralLeadingDot": true
        }
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://huggingface.co https://cdn-lfs-us-1.huggingface.co https://cdn-lfs.huggingface.co https://huggingface.co"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQTNDMkZDODhGOEFGMTkKUldRWnIvaUkvTUtqZklhYU9PbUNmRzJ6YmNTQkR2S3NvOWNsdENTWCtVM2E1K3J3Z2FzNW9mbnIK",
      "endpoints": [
        "https://github.com/bispitalieri/biolaris-media/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
