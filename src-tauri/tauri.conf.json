{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biolaris Media",
  "version": "0.1.0",
  "identifier": "dev.biolaris-media.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Biolaris Media",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 1100,
        "maxHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/runtime-current/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
